# ============================================================
# RentNest — Environment Variables
# ============================================================
# Copy this file to ".env" and fill in your values:
#   cp .env.example .env
#
# Docker Compose automatically reads the .env file.
# NEVER commit the .env file to Git (it's in .gitignore).
# ============================================================

# --- PostgreSQL Database ---
POSTGRES_DB=rentnest
POSTGRES_USER=rentnest_user
POSTGRES_PASSWORD=rentnest_pass

# --- Backend ---
# For local Docker: leave blank (docker-compose.yml auto-builds the URL from POSTGRES_* vars above)
# For production/Neon: set the full JDBC connection string
# DATABASE_URL=jdbc:postgresql://your-host:5432/your-db?user=your-user&password=your-pass&sslmode=require

# JWT secret key (MUST change this in production — use a random 64+ character string)
JWT_SECRET=rentnest-dev-secret-key-change-in-production-min-256-bits-long!!

# Allowed CORS origins (comma-separated, no trailing slashes)
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# --- AI API Keys (optional — AI features won't work without these) ---
GEMINI_API_KEY=
GROQ_API_KEY=
